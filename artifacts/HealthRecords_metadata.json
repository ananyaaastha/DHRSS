		"devdoc": {
			"author": "Ananya Aastha — N12125547 | IFB452 Blockchain Technology, QUT",
			"details": "Cross-contract interactions:   This contract calls PatientRegistry to verify stakeholder roles.   This contract calls AccessControl to verify consent before returning data.   This demonstrates direct smart contract interaction as required by the spec.Architecture:   PatientRegistry  ←── HealthRecords ──→  AccessControl        ↑                                        ↑   role checks                          consent checks",
			"kind": "dev",
			"methods": {
				"addRecord(address,string,bytes32,uint8)": {
					"details": "Calls PatientRegistry to verify patient is registered.      Calls AccessControl to verify consent for doctors and pharmacists.      Only the IPFS hash is stored — raw data lives off-chain on IPFS.",
					"params": {
						"_fileHash": "keccak256 hash of the file for integrity verification",
						"_ipfsHash": "IPFS CID of the encrypted medical file",
						"_patient": "Patient wallet address",
						"_recordType": "Type of medical record being added"
					}
				},
				"constructor": {
					"params": {
						"_accessControlAddress": "Address of the deployed AccessControl contract",
						"_registryAddress": "Address of the deployed PatientRegistry contract"
					}
				},
				"getRecordCount(address)": {
					"params": {
						"_patient": "Patient wallet address"
					},
					"returns": {
						"_0": "Number of records stored for this patient"
					}
				},
				"getRecords(address)": {
					"details": "Calls PatientRegistry to verify roles.      Calls AccessControl to verify consent for doctors/pharmacists/insurers.      Emergency personnel can access without consent — audit log in AccessControl.",
					"params": {
						"_patient": "Patient wallet address whose records to retrieve"
					},
					"returns": {
						"_0": "Array of Record structs belonging to the patient"
					}
				}
			},
			"title": "HealthRecords",
			"version": 1
		},

		"devdoc": {
			"author": "Ananya Aastha — N12125547 | IFB452 Blockchain Technology, QUT",
			"details": "Architecture overview:  Stakeholders  →  HealthRecords Smart Contract  →  IPFS (off-chain encrypted storage)  Six stakeholders:   1. Patient          — owns records, manages all consent   2. Doctor / GP      — reads and adds records with patient consent   3. Hospital         — same as doctor, also registers emergency personnel   4. Pharmacist       — reads and marks prescriptions as dispensed   5. Insurer          — read-only with explicit patient consent   6. Regulator        — admin-level read of anonymised audit data  Novel features vs MedRec (Azaria et al., 2016):   1. Auto-expiry consent  — permissions revoke automatically at block.timestamp   2. Emergency override with penalty mechanism — strikes + suspension on misuse",
			"events": {
				"PatientAlerted(address,address,uint256,uint256)": {
					"details": "NOVEL — patient is immediately alerted when emergency access occurs"
				},
				"ProviderPenalised(address,uint256,bool,uint256)": {
					"details": "NOVEL — penalty mechanism for unjustified emergency access"
				}
			},
			"kind": "dev",
			"methods": {
				"addRecord(address,string,bytes32,uint8)": {
					"details": "Caller must be: patient themselves | consented doctor | consented pharmacist",
					"params": {
						"_fileHash": "keccak256 hash of the file for integrity verification",
						"_ipfsHash": "IPFS CID of the encrypted file",
						"_patient": "Patient wallet address",
						"_recordType": "Type of medical record"
					}
				},
				"emergencyAccess(address,string)": {
					"details": "Issues a 4-hour read-only token. Patient is immediately alerted on-chain.      Every access is permanently logged for governance review.",
					"params": {
						"_patient": "Patient wallet address to access",
						"_reason": "Clinical justification — stored permanently on-chain"
					}
				},
				"getAggregateStats()": {
					"returns": {
						"totalEvents": "Total emergency events logged",
						"totalRecs": "  Total records across all patients"
					}
				},
				"getRecords(address)": {
					"details": "Access: patient | consented doctor | consented pharmacist |              consented insurer | emergency personnel"
				},
				"grantConsent(address,uint256)": {
					"details": "Consent auto-expires at block.timestamp >= expiryTime — no patient action needed",
					"params": {
						"_durationSec": "Duration in seconds (e.g. 86400 = 1 day)",
						"_provider": "Provider wallet address"
					}
				},
				"reviewAccess(uint256,bool,string)": {
					"details": "If unjustified, penalisePersonnel is called automatically",
					"params": {
						"_eventId": "The emergency event ID to review",
						"_isJustified": "Whether the access was clinically justified",
						"_note": "Reviewer's note explaining the decision"
					}
				},
				"verifyRecordIntegrity(address,uint256,bytes32)": {
					"params": {
						"_fileHash": "Hash to check against stored hash",
						"_patient": "Patient address",
						"_recordIdx": "Index in the patient's record array"
					},
					"returns": {
						"intact": "   True if hashes match"
					}
				}
			},
			"title": "HealthRecords",
			"version": 1
		},

		"devdoc": {
			"author": "Ananya Aastha — N12125547 | IFB452 Blockchain Technology, QUT",
			"details": "NOVEL features vs MedRec (Azaria et al., 2016):   1. Auto-expiry consent — permissions revoke automatically at block.timestamp      No patient action needed — the contract enforces expiry automatically   2. Emergency override with penalty mechanism      Every access is permanently logged. Unjustified access = strike.      Three strikes = automatic suspension from the network.Cross-contract interaction:   This contract calls PatientRegistry to verify roles before   granting or revoking consent and before allowing emergency access.",
			"events": {
				"PatientAlerted(address,address,uint256,uint256)": {
					"details": "NOVEL — patient is immediately alerted on-chain when emergency access occurs"
				},
				"ProviderPenalised(address,uint256,bool,uint256)": {
					"details": "NOVEL — emitted when emergency personnel receive a penalty strike"
				}
			},
			"kind": "dev",
			"methods": {
				"constructor": {
					"params": {
						"_registryAddress": "Address of the deployed PatientRegistry contract"
					}
				},
				"emergencyAccess(address,string)": {
					"details": "Calls PatientRegistry to verify caller is registered emergency personnel      and that the patient is registered. Issues a 4-hour read-only token.      Patient is immediately alerted on-chain via PatientAlerted event.      Every access is permanently logged — records can never be deleted.",
					"params": {
						"_patient": "Patient wallet address whose records are being accessed",
						"_reason": "Clinical justification — stored permanently on-chain"
					}
				},
				"grantConsent(address,uint256)": {
					"details": "Calls PatientRegistry to verify caller is a registered patient      and that the provider is a registered doctor/pharmacist/insurer.      Consent auto-expires at block.timestamp >= expiryTime — no patient action needed.",
					"params": {
						"_durationSec": "Duration in seconds (e.g. 86400 = 1 day, 3600 = 1 hour)",
						"_provider": "Provider wallet address to grant access to"
					}
				},
				"hasValidConsent(address,address)": {
					"details": "Called by HealthRecords before returning patient data      NOVEL — checks both active flag AND timestamp expiry",
					"params": {
						"_patient": "Patient wallet address",
						"_provider": "Provider wallet address"
					},
					"returns": {
						"_0": "true if consent is active and not yet expired"
					}
				},
				"reviewAccess(uint256,bool,string)": {
					"details": "If unjustified, _penalisePersonnel is called automatically.      Three unjustified accesses = automatic suspension.",
					"params": {
						"_eventId": "The emergency event ID to review",
						"_isJustified": "Whether the access was clinically justified",
						"_note": "Reviewer's note explaining the decision"
					}
				},
				"revokeConsent(address)": {
					"details": "Calls PatientRegistry to verify caller is a registered patient",
					"params": {
						"_provider": "Provider wallet address to revoke access from"
					}
				}
			},
			"stateVariables": {
				"consents": {
					"details": "NOVEL — auto-expiry checked at call time, no cron job needed"
				}
			},
			"title": "AccessControl",
			"version": 1
		},
		"userdoc": {
			"events": {
				"AccessReviewed(uint256,bool,string,uint256)": {
					"notice": "Emitted when admin reviews an emergency access event"
				},
				"ConsentGranted(address,address,uint256)": {
					"notice": "Emitted when a patient grants time-limited consent to a provider"
				},
				"ConsentRevoked(address,address,uint256)": {
					"notice": "Emitted when a patient manually revokes consent before expiry"
				},
				"EmergencyOverride(address,address,uint256,string,uint256)": {
					"notice": "Emitted when emergency personnel access records without consent"
				}
			},
			"kind": "user",
			"methods": {
				"EMERGENCY_DURATION()": {
					"notice": "Emergency access token lasts 4 hours — read-only window"
				},
				"MAX_STRIKES()": {
					"notice": "Three unjustified accesses triggers automatic suspension"
				},
				"admin()": {
					"notice": "Address of the contract deployer — has admin privileges"
				},
				"constructor": {
					"notice": "Sets admin and links to the deployed PatientRegistry contract"
				},
				"credentials(address)": {
					"notice": "Penalty record for each emergency personnel address"
				},
				"emergencyAccess(address,string)": {
					"notice": "NOVEL — Emergency personnel access records without prior consent"
				},
				"emergencyEvents(uint256)": {
					"notice": "Permanent registry of all emergency events — immutable audit trail"
				},
				"getConsentExpiry(address,address)": {
					"notice": "Returns the expiry timestamp for a provider's consent (0 if none)"
				},
				"getCredential(address)": {
					"notice": "Returns penalty info for emergency personnel"
				},
				"getEmergencyLogCount()": {
					"notice": "Returns total number of emergency events ever logged"
				},
				"grantConsent(address,uint256)": {
					"notice": "NOVEL — Grant time-limited consent to a provider"
				},
				"hasValidConsent(address,address)": {
					"notice": "Check if a provider currently has valid non-expired consent"
				},
				"patientEmergencyLog(address,uint256)": {
					"notice": "patient => list of emergency event IDs affecting them"
				},
				"registry()": {
					"notice": "Reference to PatientRegistry for cross-contract role verification"
				},
				"reviewAccess(uint256,bool,string)": {
					"notice": "NOVEL — Governance review of an emergency access event"
				},
				"revokeConsent(address)": {
					"notice": "Manually revoke a provider's consent before expiry"
				},
				"totalEmergencyEvents()": {
					"notice": "Total number of emergency events ever logged"
				}
			},
			"notice": "Contract 2 of 3 — Consent and Emergency Access Management         Manages time-limited consent grants between patients and providers.         Handles emergency override with permanent on-chain logging.         Called by HealthRecords before returning any patient data.",
			"version": 1
		}

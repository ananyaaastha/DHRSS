		"devdoc": {
			"author": "Ananya Aastha — N12125547 | IFB452 Blockchain Technology, QUT",
			"details": "Stakeholders:   1. Patient          — self-registers using their wallet   2. Doctor           — registered by admin after credential verification   3. Pharmacist       — registered by admin   4. Insurer          — registered by admin, read-only with patient consent   5. Emergency        — registered by admin, bypass consent in emergencies   6. Regulator        — registered by admin, anonymised audit access only",
			"kind": "dev",
			"methods": {
				"registerDoctor(address)": {
					"params": {
						"_doctor": "Wallet address of the doctor to register"
					}
				},
				"registerEmergencyPersonnel(address)": {
					"details": "Emergency personnel can bypass consent in genuine emergencies",
					"params": {
						"_person": "Wallet address of the emergency personnel to register"
					}
				},
				"registerInsurer(address)": {
					"params": {
						"_insurer": "Wallet address of the insurer to register"
					}
				},
				"registerPatient()": {
					"details": "No admin approval needed — patients own their registration"
				},
				"registerPharmacist(address)": {
					"params": {
						"_pharmacist": "Wallet address of the pharmacist to register"
					}
				},
				"registerRegulator(address)": {
					"params": {
						"_regulator": "Wallet address of the regulator to register"
					}
				}
			},
			"title": "PatientRegistry",
			"version": 1
		},
		"userdoc": {
			"events": {
				"PatientRegistered(address,uint256)": {
					"notice": "Emitted when a patient self-registers"
				},
				"ProviderRegistered(address,uint8,uint256)": {
					"notice": "Emitted when admin registers any provider role"
				}
			},
			"kind": "user",
			"methods": {
				"admin()": {
					"notice": "Address of the contract deployer — has admin privileges"
				},
				"constructor": {
					"notice": "Sets the deployer as admin on deployment"
				},
				"getRole(address)": {
					"notice": "Returns the role enum for any address"
				},
				"isDoctor(address)": {
					"notice": "Check if an address is a registered doctor"
				},
				"isEmergencyPersonnel(address)": {
					"notice": "Check if an address is registered emergency personnel"
				},
				"isInsurer(address)": {
					"notice": "Check if an address is a registered insurer"
				},
				"isPatient(address)": {
					"notice": "Check if an address is a registered patient"
				},
				"isPharmacist(address)": {
					"notice": "Check if an address is a registered pharmacist"
				},
				"isRegulator(address)": {
					"notice": "Check if an address is a registered regulator"
				},
				"registerDoctor(address)": {
					"notice": "Stakeholder 2 — Admin registers a verified doctor / GP"
				},
				"registerEmergencyPersonnel(address)": {
					"notice": "Stakeholder 5 — Admin registers emergency personnel"
				},
				"registerInsurer(address)": {
					"notice": "Stakeholder 4 — Admin registers an insurance company"
				},
				"registerPatient()": {
					"notice": "Stakeholder 1 — Patients self-register using their wallet"
				},
				"registerPharmacist(address)": {
					"notice": "Stakeholder 3 — Admin registers a pharmacist"
				},
				"registerRegulator(address)": {
					"notice": "Stakeholder 6 — Admin registers a government regulator"
				},
				"registeredPatients(address)": {
					"notice": "Role registries — one mapping per stakeholder type"
				}
			},
			"notice": "Contract 1 of 3 — Stakeholder Registration         Manages all role assignments for the DHRSS system.         This is the source of truth for identity verification.         AccessControl and HealthRecords call this contract to verify roles         before performing any sensitive operations.",
			"version": 1
		}
